{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "cyberfleet",
	"version": "0.11.1",
	"description": "Fleet & crew personas over cyberlegion — Pod (ship's bridge), Operator (command center), Crimp (crew recruitment), and Mechanic (automaton building).",
	"author": {
		"name": "unional"
	},
	"homepage": "https://github.com/cyberuni/cyberfleet",
	"repository": "https://github.com/cyberuni/cyberfleet",
	"keywords": ["agent", "dispatch", "inter-agent", "fleet"],
	"extensions": {
		"org.cyberuni.universal-plugin": {
			"vendors": ["claude-code", "codex"],
			"skills": "./skills",
			"agents": ["./agents/headless-operator.md", "./agents/headless-close-sessions.md"],
			"scripts": {
				"skills/close-sessions/scripts/cyberfleet.mjs": { "forward": "cyberfleet" },
				"skills/jump/scripts/cyberfleet.mjs": { "forward": "cyberfleet" },
				"skills/operator/scripts/cyberfleet.mjs": { "forward": "cyberfleet" },
				"skills/pod/scripts/cyberfleet.mjs": { "forward": "cyberfleet" },
				"skills/crimp/scripts/cyberlegion.mjs": {
					"forward": "cyberlegion",
					"package": "cyberlegion",
					"version": "2.2.0"
				},
				"skills/operator/scripts/cyberlegion.mjs": {
					"forward": "cyberlegion",
					"package": "cyberlegion",
					"version": "2.2.0"
				},
				"skills/pod/scripts/cyberlegion.mjs": { "forward": "cyberlegion", "package": "cyberlegion", "version": "2.2.0" }
			},
			"harnesses": {
				"claude-code": {},
				"codex": {}
			}
		}
	}
}
